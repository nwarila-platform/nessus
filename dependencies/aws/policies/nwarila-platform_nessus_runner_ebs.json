{
  "Statement": [
    {
      "Action": [
        "ec2:DescribeVolumes",
        "ec2:DescribeVolumeAttribute"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "DescribeVolumes"
    },
    {
      "Action": "ec2:CreateVolume",
      "Condition": {
        "Null": {
          "aws:RequestTag/CommitSha": "false",
          "aws:RequestTag/Environment": "false",
          "aws:RequestTag/RunId": "false"
        },
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Repository": "nwarila-platform/nessus",
          "aws:RequestTag/RepositoryId": "<repository-id>"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "CreateTaggedVolume"
    },
    {
      "Action": [
        "ec2:AttachVolume",
        "ec2:DetachVolume"
      ],
      "Condition": {
        "Null": {
          "ec2:ResourceTag/CommitSha": "false",
          "ec2:ResourceTag/Environment": "false",
          "ec2:ResourceTag/RunId": "false"
        },
        "StringEquals": {
          "ec2:ResourceTag/ManagedBy": "Terraform",
          "ec2:ResourceTag/Repository": "nwarila-platform/nessus",
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ec2:<region>:<account-id>:volume/*",
        "arn:aws:ec2:<region>:<account-id>:instance/*"
      ],
      "Sid": "AttachDetachOwnedVolumeAndInstance"
    },
    {
      "Action": "ec2:DeleteVolume",
      "Condition": {
        "Null": {
          "ec2:ResourceTag/CommitSha": "false",
          "ec2:ResourceTag/Environment": "false",
          "ec2:ResourceTag/RunId": "false"
        },
        "StringEquals": {
          "ec2:ResourceTag/ManagedBy": "Terraform",
          "ec2:ResourceTag/Repository": "nwarila-platform/nessus",
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:<region>:<account-id>:volume/*",
      "Sid": "DeleteOwnedVolume"
    },
    {
      "Action": "ec2:DescribeSnapshots",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "DescribeSnapshots"
    },
    {
      "Action": "ec2:CreateSnapshot",
      "Condition": {
        "Null": {
          "ec2:ResourceTag/CommitSha": "false",
          "ec2:ResourceTag/Environment": "false",
          "ec2:ResourceTag/RunId": "false"
        },
        "StringEquals": {
          "ec2:ResourceTag/ManagedBy": "Terraform",
          "ec2:ResourceTag/Repository": "nwarila-platform/nessus",
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:<region>:<account-id>:volume/*",
      "Sid": "SnapshotOnlyOwnedVolumes"
    },
    {
      "Action": "ec2:CreateSnapshot",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "aws-deploy",
          "aws:RequestTag/Preserve": "true",
          "aws:RequestTag/Repository": "nwarila-platform/nessus",
          "aws:RequestTag/RepositoryId": "<repository-id>"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:<region>::snapshot/*",
      "Sid": "CreateOnlyTaggedPreservationSnapshots"
    },
    {
      "Action": "ec2:CreateTags",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateSnapshot"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:<region>::snapshot/*",
      "Sid": "TagPreservationSnapshotsOnCreateOnly"
    },
    {
      "Action": "ec2:DeleteSnapshot",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/ManagedBy": "aws-deploy",
          "ec2:ResourceTag/Preserve": "true",
          "ec2:ResourceTag/Repository": "nwarila-platform/nessus",
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:<region>::snapshot/*",
      "Sid": "DeleteOnlyOwnPreservationSnapshots"
    },
    {
      "Action": "ec2:CreateVolume",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/ManagedBy": "aws-deploy",
          "ec2:ResourceTag/Preserve": "true",
          "ec2:ResourceTag/Repository": "nwarila-platform/nessus",
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:<region>::snapshot/*",
      "Sid": "CreateVolumesOnlyFromOwnPreservationSnapshots"
    }
  ],
  "Version": "2012-10-17"
}
